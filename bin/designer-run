#!/usr/bin/env python3
"""Run one designer outside a checkout; print the final report's path.

  designer-run --prompt-file FILE [--out DIR] [--fallback] [--read FILE ...]

The prompt is RULES.md, the designer body, the brief, then its output folder
and copied project files.
Routes come from routing.json. Launch and finish go to the launch log; the
single JSON result and its result text go beside each other under reports/.
The sandbox permits writes only in the output folder and the run's temp folder,
network only to localhost, no credential files or variables, and no processes
left running.
Exit codes: Claude's own, 2 for usage, routing or unreadable result problems.
Claude flags: `claude --help` (Claude Code 2.1.308): -p/--print,
--output-format json, --model MODEL, --effort high, --restricted,
--strict-mcp-config, --tools, --settings, --allowedTools and
--disallowedTools (space-separated tool names and permission rules),
--permission-mode dontAsk (default when dontAsk is absent from help):
https://code.claude.com/docs/en/cli-reference
Absolute permission paths use //, as in Edit(//absolute/path/**):
https://code.claude.com/docs/en/permissions
"""
import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time


SANDBOX = {
    "enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False,
    "autoAllowBashIfSandboxed": True,
    "network": {"allowedDomains": [], "allowLocalBinding": True},
    "filesystem": {"denyRead": ["~/.claude.json", "~/.claude/.credentials.json", "~/.claude/projects",
        "~/.config/gh", "~/.git-credentials", "~/.netrc", "~/.ssh", "~/.aws", "~/.docker", "~/.kube",
        "~/.gnupg", "~/Library/Keychains"]},
}
CLAUDE_AUTH = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN")
SENSITIVE = re.compile(r"TOKEN|SECRET|PASSWORD|PASSWD|PASS$|ASKPASS|CREDENTIAL|API_?KEY|ACCESS_?KEY|PRIVATE_?KEY|AUTH", re.I)


def run_processes(name, folders):
    found = set()
    def inside(path):
        path = os.path.realpath(path)
        return any(os.path.commonpath((path, folder)) == folder for folder in folders)
    if os.path.isdir("/proc"):
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                base = "/proc/" + pid
                if os.stat(base).st_uid != os.getuid():
                    continue
                with open(base + "/environ", "rb") as stream:
                    marked = ("DESIGNER_RUN=" + name).encode() in stream.read().split(b"\0")
                if marked or inside(os.readlink(base + "/cwd")):
                    found.add(int(pid))
            except OSError:
                continue
    else:
        for argv in (["ps", "-E", "-ww", "-o", "pid=", "-o", "command=", "-U", str(os.getuid())],
                     ["lsof", "-a", "-d", "cwd", "-u", str(os.getuid()), "-Fpn"]):
            try:
                output = subprocess.run(argv, capture_output=True, text=True, check=True).stdout
                pid = None
                for line in output.splitlines():
                    if argv[0] == "ps":
                        if re.search(r" DESIGNER_RUN=" + re.escape(name) + r"(?=\s|$)", line):
                            found.add(int(line.split(None, 1)[0]))
                    elif line.startswith("p"):
                        pid = int(line[1:])
                    elif line.startswith("n") and pid and inside(line[1:]):
                        found.add(pid)
            except (OSError, ValueError, subprocess.CalledProcessError):
                print("designer-run: warning: cannot scan processes with " + argv[0], file=sys.stderr)
    return found - {os.getpid()}


def stop_processes(child, name, out, temporary):
    def send(pid, sig):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            pass
    if child is not None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    found = run_processes(name, (out, temporary))
    for pid in found:
        send(pid, signal.SIGTERM)
    deadline = time.monotonic() + 2
    pending = set(found)
    while pending and time.monotonic() < deadline:
        for pid in tuple(pending):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                pending.remove(pid)
        if pending:
            time.sleep(0.05)
    for pid in pending:
        send(pid, signal.SIGKILL)
    remaining = run_processes(name, (out, temporary))
    for pid in remaining:
        send(pid, signal.SIGKILL)
    return len(found | remaining)


def die(message):
    print("designer-run: " + str(message), file=sys.stderr)
    sys.exit(2)


def read(path):
    try:
        with open(path) as stream:
            return stream.read()
    except OSError as error:
        die("cannot read %s: %s" % (path, error))


def write_log(directory, entry):
    try:
        with open(os.path.join(directory, "launch-log.jsonl"), "a") as stream:
            stream.write(json.dumps(entry, sort_keys=True) + "\n")
    except OSError as error:
        print("designer-run: cannot write the launch log: %s" % error, file=sys.stderr)


def outside_checkout(out):
    probe = out
    while not os.path.exists(probe):
        probe = os.path.dirname(probe)
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    try:
        check = subprocess.run(["git", "-C", probe, "rev-parse", "--is-inside-work-tree"],
                               capture_output=True, text=True, env=env)
    except OSError as error:
        die("cannot check the output folder: %s" % error)
    if check.stdout.strip() == "true":
        die("the output folder must be outside a git work tree")
    if check.returncode and "not a git repository" not in check.stderr:
        die("cannot check the output folder: " + check.stderr.strip())


def main():
    parser = argparse.ArgumentParser(prog="designer-run")
    parser.add_argument("--prompt-file", required=True)
    parser.add_argument("--out")
    parser.add_argument("--fallback", action="store_true")
    parser.add_argument("--read", action="append", default=[])
    args = parser.parse_args()
    inputs = []
    for path in args.read:
        source = os.path.abspath(os.path.expanduser(path))
        if not os.path.isfile(source):
            die("project input must be a regular file: " + path)
        if os.path.basename(source) in [os.path.basename(item) for item in inputs]:
            die("project inputs must have distinct base names")
        inputs.append(source)
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    try:
        routing = json.loads(read(os.path.join(root, "routing.json")))
        route_name = "fallback" if args.fallback else "primary"
        route = routing["roles"]["designer"][route_name]
        if (route.get("family") != "claude" or not isinstance(route.get("model"), str)
                or not route["model"] or route.get("effort") not in ("low", "medium", "high", "xhigh", "max")):
            raise ValueError("invalid Claude route")
    except (ValueError, KeyError, TypeError, AttributeError) as error:
        die("invalid designer route: %s" % error)
    rules = read(os.path.join(root, "RULES.md")).strip()
    if not rules:
        die("RULES.md is empty")
    body = re.sub(r"\A---\n.*?\n---\n", "", read(os.path.join(root, "agents", "designer.md")), flags=re.S).strip()
    brief = read(args.prompt_file)
    directory = os.path.realpath(os.path.expanduser(os.environ.get("AGENTIC_LOG_DIR") or "~/.claude/agentic-workflows"))
    name = "designer-%s-%d" % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.getpid())
    requested = os.path.expanduser(args.out or os.path.join(directory, "designs", name))
    out = os.path.realpath(requested)
    if any(char in requested or char in out for char in "()*?[]\n"):
        die("the output folder contains permission-rule characters")
    protected = (os.path.expanduser("~"), os.path.expanduser("~/.claude"), directory, root)
    if any(os.path.commonpath((out, os.path.realpath(path))) == out for path in protected):
        die("the output folder must not contain a protected folder")
    outside_checkout(out)
    try:
        os.makedirs(out, exist_ok=True)
        reports = os.path.join(directory, "reports")
        os.makedirs(reports, exist_ok=True)
    except OSError as error:
        die("cannot create output folders: %s" % error)
    report = os.path.join(reports, name + ".md")
    result_path = os.path.join(reports, name + ".json")
    full = rules + "\n\n---\n\n" + body + "\n\n---\n\n" + brief + "\n\nOutput folder: " + out + "\n"
    env = {key: value for key, value in os.environ.items()
           if key in CLAUDE_AUTH or (key not in ("CLAUDECODE", "SSH_AUTH_SOCK") and not SENSITIVE.search(key))}
    env["DESIGNER_RUN"] = name
    try:
        help_text = subprocess.run(["claude", "--help"], capture_output=True, text=True, env=env, cwd=out, check=True).stdout
    except (OSError, subprocess.CalledProcessError) as error:
        die("cannot check claude --help: %s" % error)
    for flag in ("--restricted", "--strict-mcp-config", "--tools", "--settings"):
        if flag not in help_text:
            die("claude lacks required sandbox flag " + flag)
    for source in inputs:
        target = os.path.join(out, "input", os.path.basename(source))
        try:
            os.makedirs(os.path.dirname(target), exist_ok=True)
            shutil.copyfile(source, target)
        except OSError as error:
            die("cannot copy project input: %s" % error)
        full += "Project file: %s (copy of %s)\n" % (target, source)
    settings = {"sandbox": dict(SANDBOX, credentials={"envVars": [
        {"name": key, "mode": "deny"} for key in CLAUDE_AUTH if key in env]})}
    mode = "dontAsk" if "dontAsk" in help_text else "default"
    argv = ["claude", "-p", "--output-format", "json", "--model", route["model"],
            "--effort", route["effort"], "--restricted", "--strict-mcp-config",
            "--tools", "Read", "Grep", "Glob", "Bash", "Edit", "Write",
            "--settings", json.dumps(settings), "--allowedTools", "Read", "Grep", "Glob", "Bash",
            "Edit(/%s/**)" % out, "Write(/%s/**)" % out,
            "--disallowedTools", "NotebookEdit", "--permission-mode", mode]
    usage = {key: None for key in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")}
    entry = {"session": os.environ.get("CLAUDE_CODE_SESSION_ID"), "session_id": None,
             "role": "designer", "tool": "designer-run", "model": route["model"],
             "effort": route["effort"], "route": route_name, "design": True,
             "out": out, "report": report, "exit_code": None, **usage}
    def log(decision):
        write_log(directory, dict(entry, decision=decision, time=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())))
    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, interrupted)
    temporary = os.path.realpath(tempfile.mkdtemp(prefix="designer.", dir="/tmp"))
    env["CLAUDE_CODE_TMPDIR"] = temporary
    child = None
    rc = 2
    try:
        log("launch")
        with open(result_path, "wb") as stream:
            child = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=stream, cwd=out,
                                     env=env, start_new_session=True)
            child.communicate(full.encode())
        rc = child.returncode if child.returncode >= 0 else 128 - child.returncode
    except OSError as error:
        entry["error"] = str(error)
        print("designer-run: cannot launch claude: %s" % error, file=sys.stderr)
    except SystemExit as error:
        rc = error.code
        raise
    finally:
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(sig, signal.SIG_IGN)
        try:
            entry["stopped"] = stop_processes(child, name, out, temporary)
        finally:
            shutil.rmtree(temporary, ignore_errors=True)
        if child is not None and child.poll() is None:
            child.wait()
        entry["exit_code"] = rc
        if sys.exc_info()[0] is not None:
            log("finished")
    try:
        with open(result_path) as stream:
            result = json.load(stream)
        if not isinstance(result, dict) or not isinstance(result.get("result"), str):
            raise ValueError("missing result text")
        entry["session_id"] = result.get("session_id")
        counts = result.get("usage")
        if isinstance(counts, dict):
            for key in usage:
                value = counts.get(key)
                if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
                    entry[key] = value
        with open(report, "w") as stream:
            stream.write(result["result"])
    except (ValueError, OSError) as error:
        entry["error"] = "unreadable result: %s" % error
        rc = rc or 2
    entry["exit_code"] = rc
    log("finished")
    if os.path.isfile(report):
        print(report)
    return rc


if __name__ == "__main__":
    sys.exit(main())
