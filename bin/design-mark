#!/usr/bin/env python3
"""Mark the PM's design work in the launch log: start|end --item URL."""
import argparse
import datetime
import json
import os
from pathlib import Path
import sys


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("mark", choices=("start", "end"))
    p.add_argument("--item", required=True)
    a = p.parse_args()
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session or not a.item.strip():
        p.error("a session id and --item are required")
    base = Path(os.environ.get("AGENTIC_LOG_DIR") or "~/.claude/agentic-workflows").expanduser()
    entry = dict(decision="design-mark", mark=a.mark, item=a.item, session=session,
                 time=datetime.datetime.now(datetime.timezone.utc).isoformat(), tool="design-mark")
    try:
        base.mkdir(parents=True, exist_ok=True)
        with (base / "launch-log.jsonl").open("a") as f:
            f.write(json.dumps(entry, sort_keys=True) + "\n")
    except OSError as e:
        print("design-mark: cannot write the launch log: %s" % e, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
